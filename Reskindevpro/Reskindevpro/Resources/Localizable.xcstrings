        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد طلبات مكتملة بعد"
          }
        }
      }
    },
    "Orders on your services will show up here.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সার্ভিসের অর্ডার এখানে দেখা যাবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सेवाओं के ऑर्डर यहाँ दिखाई देंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الطلبات على خدماتك."
          }
        }
      }
    },
    "Orders you place will show up here.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার করা অর্ডার এখানে দেখা যাবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा दिए गए ऑर्डर यहाँ दिखाई देंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الطلبات التي تقدّمها."
          }
        }
      }
    },
    "No messages yet": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো বার্তা নেই"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
