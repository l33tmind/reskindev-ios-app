    },
    "Contact a seller from any service to start a chat.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যাট শুরু করতে যেকোনো সার্ভিস থেকে বিক্রেতার সাথে যোগাযোগ করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट शुरू करने के लिए किसी भी सेवा से विक्रेता से संपर्क करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تواصل مع بائع من أي خدمة لبدء محادثة."
          }
        }
      }
    },
