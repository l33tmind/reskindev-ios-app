      }
    },
    "No finished orders yet": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো সম্পন্ন অর্ডার নেই"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई पूरा ऑर्डर नहीं"
